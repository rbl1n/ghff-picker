Project "ghff_picker" {
  database_type: "JSON snapshot + browser localStorage"
  Note: '''
  金馬影展選片排程工具（個人模式與兩人各自片單模式）的資料邊界。無後端、無資料庫。
  三類資料：
  1. 場次快照（catalog）：抓資料腳本從官網產生的 sessions.json，唯讀、進版控（CL-008）。
  2. 使用者狀態（user_state）：存在瀏覽器 localStorage，可經分享連結帶到另一台裝置（FR-018、FR-022）。
  3. 衍生結果（derived）：排程引擎依 1 + 2 即時計算，不保存；重開工具時重算。有同伴時，兩人各自以自己的分層、層內排序、有空時段、每日上限為輸入，同時產生兩人行程，每場帶參與者（一起／自己／同伴；003 CL-301、FR-306～FR-308）。003 取消 002 的「合併結果」（merged_*）。
  另有一種不落地的資料：分享連結內容（share_payload），分「個人」與「合併結果」兩種（002 CL-202、FR-212；003 沿用，內容升為 schema_version 3）。
  每人每天的供給是「有空時段」：分鐘精度的有空區間集合，未設定的日期預設全天有空；小時格子與不可看時段編輯同一份資料（003 CL-302、FR-301）。「不可看時段」不再是獨立資料，而是有空時段的補集（顯示用）。
  時間一律為 Asia/Taipei 牆上時間：date = YYYY-MM-DD，分鐘數 = 自當日 00:00 起算（NFR-005、research 決策 6）。
  '''
}

// ───────── 場次快照（catalog，sessions.json） ─────────

Enum cinema {
  xinyi_vieshow   // 台北信義威秀
  songren_muvie   // 松仁威秀（官網表頭「MUVIE」，含 TITAN 廳；CL-004）
  unknown         // 僅作無法辨識表頭時的保守值，轉場緩衝以 15 分鐘計（FR-010）；台北以外影城不收入（CL-012）
}

Enum session_mark {
  guest_attending        // ★ 影人出席
  mandarin_no_subtitle   // ◆ 華語無中英字幕
  no_english_subtitle    // ▲ 非英語無英文字幕
  non_ticketed           // ⊚ 非售票活動
  priority_screening     // 優先特映場（官網有、spec 未提；只顯示）
}

Table catalog {
  festival_year int [pk]
  source_url varchar
  fetched_at timestamp

  Note: '快照中繼資料；整份 sessions.json 的根。'
}

Table films {
  film_id varchar [pk, note: '官網 films/detail/<id>']
  title varchar
  runtime_min int [note: '片長（分）']
  rating varchar [note: '分級，例：普、12+、15+']
  shorts "{title, catalog_no?}[]" [null, note: '短片單元（官網一列放映多部短片，標題列為【單元名】）才有：片名 = 單元名（不含括號），film_id 沿用第一部短片的編號，shorts = 依官網順序的短片 {title, catalog_no?}，每部短片帶自己的手冊頁碼；單元的 catalog_no = 其中最小的頁碼。一般影片沒有此欄位']
  catalog_no varchar [null, note: '紙本手冊目次表的頁碼（片號），三位數字字串，例：089；使用者以此稱呼影片。由 scripts/scrape/catalog-numbers.json 對照產生，沒有對照到者為空。films 陣列依手冊順序排列：片號由小到大、同號依目次表位置、沒有片號者接在最後（保持原順序）；所有「影片順序」（同分決勝、層內名次初始化）都以此順序為準。']

  Note: '影片；擁有一或多個場次。短片單元在官網以第一部短片的片名上架，片號取該單元的起始頁。使用者以影片為單位分層（FR-002、FR-004）。'
}

Table venues {
  venue_name varchar [pk, note: '官網影廳原文，例：信義威秀10廳、TITAN']
  cinema cinema

  Note: '影廳與所屬影城；決定轉場緩衝（FR-010）。'
}

Table sessions {
  session_id varchar [pk, note: '由 film_id + date + start 組成，穩定可重現']
  film_id varchar
  date date
  start_min int [note: '開演，當日分鐘數']
  end_min int [note: '散場 = start_min + runtime_min，可 > 1440 表示跨午夜']
  venue_name varchar
  marks "session_mark[]"

  Note: '單一場次。散場時間依 spec 公式推導（FR-006）。'
}

Ref: sessions.film_id > films.film_id
Ref: sessions.venue_name > venues.venue_name

// ───────── 使用者狀態（user_state，localStorage） ─────────

Enum tier {
  must      // 必看
  want      // 想看
  maybe     // 有空再看
}

Enum ticket_result {
  pending   // 未處理
  got       // 搶到（鎖定）
  missed    // 沒搶到
}

Enum share_kind {
  personal   // 個人分享連結：只含發送者自己的設定；接收端可取代、或當作同伴加入（FR-201）
  merged     // 合併結果連結：含自己、同伴、兩人姓名、手動順序與搶票標記；接收端只能取代並開啟（FR-212、FR-213）。名稱沿用 002；003 起內容是「兩人各自片單」，不是合併後的片單
}

Table user_state {
  schema_version int [pk, note: '保存格式版本；分享連結與 localStorage 共用。1 = 001 個人狀態（無姓名、無同伴）；2 = 002，新增 self_name 與 partner；3 = 003，不可看時段改存為有空時段（day_availability、available_intervals），影片分層新增層內名次（tier_rank）。讀取時 1、2、3 都接受（1 視為個人模式；1、2 讀入時依「遷移規則」轉成 3 的形狀），寫入一律為 3；高於 3 視為版本不符，顯示損毀錯誤訊息、不改任何資料']
  daily_limit int [null, note: 'null = 不設上限（CL-005）；這是「自己」的上限，只約束自己的行程（FR-306）；同伴的上限在 partner']
  manual_order "film_id[]" [null, note: '使用者手動調整的搶票順序；重新排程前保留（FR-015）；003 起作用在「自己的搶票清單」（只含自己行程中的場次，FR-312）']
  self_name varchar [null, note: '自己的顯示名稱；null = 個人模式且從未設定。進入兩人模式時必填（預設「我」，FR-209）；移除同伴時與 partner 一併清除']
  film_notes "map<film_id, text>" [null, note: '影片備註（選填，schema 仍為 3；舊資料沒有此欄位照常讀入）：film_id → 自己寫的備註文字，空字串等於刪除（不保存空值）；只屬於自己，包含在分享連結裡（取代我的設定時帶過去），但當作同伴加入時同伴連結裡的 film_notes 一律丟棄，不寫入 partner 也不顯示']
  session_marks "map<session_id, prefer|only>" [null, note: '場次偏好（005，選填，schema 仍為 3；舊資料沒有此欄位照常讀入）：prefer = 優先（軟偏好）、only = 只看這場（硬限制）；沒有標記的場次不保存、沒有任何標記時不寫欄位；包含在分享連結，當作同伴加入時帶入 partner.session_marks（同伴的標記用於排程，不是私人資料）']
  pinned_choices "map<film_id, prefer_session>" [null, note: '取捨決定（005，選填）：film_id → prefer_session = 該人的這部片限定在自己的「優先」場次（效果等同只看這場）；由行程頁取捨卡片寫入、「改回一起看」移除；沒有優先標記的片，決定不生效；移除同伴時一併清除；包含在分享連結']
  pending_hot_film_ids "film_id[]" [null, note: '尚未分層就先勾的熱門（選填，schema 仍為 3；舊資料沒有此欄位照常讀入）：勾熱門永遠不會建立層級紀錄；之後選了任一層級時該片 is_hot 設為 true 並從此清單移除，標不看或取消勾選也移除。不排程、不進層內順序與搶票；分享連結帶著，當作同伴加入時丟棄']
  top_pins "map<tier, film_id[]>" [null, note: '插播／置頂（選填，schema 仍為 3；舊資料沒有此欄位照常讀入）：層級（must／want／maybe）→ 依置頂先後的 film_id；永遠等於該層順序（tier_rank）開頭連續一段，名次以 tier_rank 為準。改層、不看、拖到未置頂者之後即移除；分享連結帶著，當作同伴加入時丟棄。與 pinned_choices（場次取捨）無關']
  theatrical_overrides "map<film_id, boolean>" [null, note: '院線標記（選填，schema 仍為 3；舊資料沒有此欄位照常讀入）：film_id → true／false，使用者手動切換選片卡片上的「院線」後寫入；有效院線旗標 = 此欄位有值就用它，否則只有 theatrical.status = confirmed 為開。只影響顯示與篩選，不影響排程與搶票；包含在分享連結，當作同伴加入時丟棄']
  updated_at timestamp

  Note: '''
  單一使用者的全部狀態根（FR-022）。
  模式由 partner 是否存在決定：沒有 partner = 個人模式（與 001 完全相同，SC-305）；有 partner = 兩人模式。
  film_preferences、day_availability / available_intervals、daily_limit、ticket_marks 永遠是「自己」的資料；加入同伴 MUST NOT 改動它們（FR-202）。
  搶票標記與手動順序只屬於自己，不與同伴合併（假設：搶票由一人負責，CL-203）。004：兩人模式的標記可標在「我的順序」或「{同伴}的順序」的任一列，仍存在本裝置的 ticket_marks（FR-409）；手動順序只在個人模式有效，兩人模式的分工不讀 manual_order（FR-404）。

  遷移規則（讀到 schema_version 1 或 2，無論來自 localStorage 或分享連結，自己與 partner 一律相同）：
  1. 不可看時段 → 有空時段：對每個有不可看時段的日期，有空時段 = 00:00–24:00 減去該日全部不可看區間（先合併重疊區間）；整天不可看 = 該日整天沒空（day_availability 有列、available_intervals 無列）；沒有不可看時段的日期不產生任何列（預設全天有空）。
  2. 層內名次：每層依場次快照的影片順序（films 的順序）指派 tier_rank = 1, 2, 3…；不在快照中的影片接在後面，保持原保存順序。這與 001 在同層同分時以影片順序決勝一致。
  3. 讀到 1／2 版時在記憶體遷移；場次資料載入完成（可補上層內名次）後立即以 3 寫回。
  '''
}

Table partner {
  display_name varchar [note: '同伴顯示名稱（預設「同伴」；FR-209）']
  session_marks "map<session_id, prefer|only>" [null, note: '同伴的場次偏好（005，選填）：來自同伴個人分享連結的 session_marks，規則同 user_state.session_marks，用於排程']
  pinned_choices "map<film_id, prefer_session>" [null, note: '同伴的取捨決定（005，選填）：在行程頁替同伴按下「看優先場」時寫入，規則同 user_state.pinned_choices']
  daily_limit int [null, note: 'null = 同伴不設上限；只約束同伴自己的行程（FR-306）']
  updated_at timestamp

  Note: '''
  同伴（002）。整張表最多一列：同一時間最多一位同伴（FR-203）；新增時若已存在，須先確認取代。
  加入同伴 = 寫入 partner 與其子表（partner_film_preferences、partner_day_availability、partner_available_intervals）；移除同伴 = 刪除這一列、子表全部列與 user_state.self_name，ticket_marks 保留（FR-204、邊界情況）。
  同伴資料來自同伴的個人分享連結（share_kind = personal）；之後只能靠重新加入同伴連結更新。
  '''
}

Table theatrical {
  film_id varchar [pk]
  status theatrical_status
  distributor varchar [null, note: '台灣片商／版權公司']
  release_date date [null, note: '台灣院線上映日（已知才有）']
  source varchar [null, note: '資料來源網址或頁面']

  Note: '''
  台灣院線上映資訊（公開靜態檔 public/data/theatrical.json，陣列；由 `npm run data:theatrical -- <研究檔>` 轉換產生）。
  缺檔、載入失敗或沒有該片的列 = unknown，不顯示錯誤。只供顯示，不影響排程與搶票。
  '''
}

Enum theatrical_status {
  confirmed       // 已確認台灣院線上映：預設院線旗標為開
  likely          // 疑似（已有台灣片商）：預設關，顯示片商提示
  not_theatrical  // 確認不會上院線
  unknown         // 不明
}

Table film_preferences {
  film_id varchar [pk]
  tier tier
  tier_rank int [note: '層內名次，1 = 該層最前（FR-304、FR-305）。同一層內名次不重複、從 1 起連續；新標記到某層或改層的影片 = 該層最後；取消標記或改層後原層後面的名次遞補；使用者拖曳 = 移到任一層的任一位置（跨層即改層並插在該位置，兩層名次皆重編；熱門保留），鍵盤上移／下移 = 與相鄰名次互換']
  is_hot boolean [note: '手動標記熱門（CL-007）；只影響自己的搶票順序']

  Note: '''
  選片偏好；沒有紀錄 = 未標記，不排程（FR-004）。
  003：新增 tier_rank（層內排序），個人與兩人模式都適用。排程目標在必看／想看／有空再看數之後、★ 之前比較排入影片的名次（FR-304）。
  '''
}

Table skipped_films {
  film_id varchar [pk]

  Note: '''
  不看（004）：使用者明確不想看的影片，保存為 user_state 的選填欄位 `skipped_film_ids`（film_id[]；沒有欄位或空陣列 = 沒有不看）。
  - 與 film_preferences 互斥：同一部片不會同時在兩邊；標為不看 = 移除該片的 film_preferences 紀錄（原層名次遞補）並加入此表；標為任一層級 = 移出此表。
  - 對排程與搶票與「未標記」相同（不排入、不進搶票清單、不當必看），只是在選片頁的「全部」「未標記」篩選中隱藏，「不看」篩選才列出，方便取消。
  - 不改 schema_version（仍為 3）：欄位選填，1、2、3 版舊資料沒有此欄位時照常讀取，遷移規則不變；分享連結 payload 的 state 一併帶出。
  - 同伴（partner）同樣可有 `skipped_film_ids`（選填）；同伴的不看只代表同伴不看這部片（沒有層級），不影響排程規則。
  '''
}

Table day_availability {
  date date [pk]

  Note: '''
  有空時段（003 取代 unavailable_slots；CL-302、FR-301）：「這一天被自訂過」的標記。
  - 沒有該日期的列 = 該日全天有空（預設，FR-005）。
  - 有列 = 該日有空時段恰為 available_intervals 中該日期的區間；沒有任何區間 = 該日整天沒空（原「整天不可看」）。
  - 正規化：區間依 start_min 排序、不重疊、不相鄰（相鄰或重疊的合併）、不為空；若該日有空區間恰為 00:00–24:00，刪除該日期的列（回到預設）。
  小時格子與「不可看時段」都只是這份資料的編輯與顯示方式：不可看時段 = 00:00–24:00 減去有空區間（顯示用，不單獨保存）。
  '''
}

Table available_intervals {
  date date
  start_min int [note: '當日分鐘數，0–1440；分鐘精度，不以小時捨入']
  end_min int [note: '> start_min，≤ 1440']

  indexes {
    (date, start_min) [pk]
  }

  Note: '''
  自己的有空區間。場次可看 ⇔ [開演, 散場] ⊆ 該場次日期的有空時段（開演到散場每一分鐘都有空；散場超過 1440 的跨午夜場次，超出的部分以隔日有空時段判斷）。
  一次套用不可看時段到多日 = 對每個日期各自從有空時段扣掉該區間（FR-007）；小時格子點擊見 FR-303（有空 → 整小時沒空；沒空 → 整小時有空；部分沒空 → 整小時沒空）。
  '''
}

Ref: available_intervals.date > day_availability.date

Table ticket_marks {
  session_id varchar [pk]
  result ticket_result

  Note: '搶票標記。got 場次重新排程時保留；missed 場次不再排入（FR-019、FR-021）。撤銷 = 刪除該筆。'
}

Table partner_film_preferences {
  film_id varchar [pk]
  tier tier
  tier_rank int [note: '同伴的層內名次，規則同 film_preferences.tier_rank']
  is_hot boolean

  Note: '同伴的選片偏好，結構同 film_preferences。film_id 不一定存在於此裝置的場次快照：不在快照中的影片排程時忽略（邊界情況），因此不建立到 films 的 Ref。'
}

Table partner_day_availability {
  date date [pk]

  Note: '同伴的有空時段標記，結構與正規化規則同 day_availability。'
}

Table partner_available_intervals {
  date date
  start_min int
  end_min int

  indexes {
    (date, start_min) [pk]
  }

  Note: '同伴的有空區間，結構同 available_intervals。'
}

Ref: partner_available_intervals.date > partner_day_availability.date

Table share_payload {
  kind share_kind
  schema_version int [note: '與 user_state.schema_version 相同（現為 3）；缺少 kind 的 v1 連結一律視為 personal；版本 1、2 的連結開啟時依 user_state 的遷移規則轉成 3']
  sender_name varchar [null, note: 'personal 連結：發送者的 self_name（若有）；接收端對話顯示「這是「{名稱}」的選片」，沒有則顯示「這是同伴的選片」。merged 連結不使用，名稱在內容裡']
  state "user_state（內嵌）" [note: 'personal：只含自己的資料（含有空時段與層內名次；不含 partner；ticket_marks 與 manual_order 照 001 帶出）；merged：含 self_name、partner（含子表）、手動順序與 ticket_marks']

  Note: '''
  分享連結內容（網址 hash 壓縮，不落地、不進 localStorage；FR-212、FR-213、FR-313）。
  接收端行為：personal → 取代我的設定／當作同伴加入／取消（FR-201）；merged → 取代並開啟／取消（FR-213）。
  損毀或版本高於 3：顯示 001 的錯誤訊息，不改變任何資料（邊界情況）。
  '''
}

Ref: film_preferences.film_id > films.film_id
Ref: ticket_marks.session_id > sessions.session_id

// ───────── 衍生結果（derived，不保存） ─────────

Enum unscheduled_reason {
  no_available_session   // 沒有可看場次
  conflicts_with_must    // 與其他必看片衝堂（附衝堂片名）
  daily_limit            // 受每日上限限制
}

Enum person_side {
  self      // 自己（本裝置使用者）
  partner   // 同伴
}

Enum itinerary_participant {
  self       // 只有自己看：行程中標「{自己名稱} 自己」
  partner    // 只有同伴看：行程中標「{同伴名稱} 自己」
  together   // 兩人買同一場次一起看：行程中標「一起」
}

Table itinerary_entries {
  session_id varchar [pk]
  participant itinerary_participant [null, note: '個人模式 = null；兩人模式 = self / partner / together（FR-310）。同一場次不會同時有「自己」與「同伴」兩列：兩人都排入同一場次即為 together（FR-308）']
  tier tier [null, note: '自己的層級；participant = partner 時為 null']
  partner_tier tier [null, note: '同伴的層級；個人模式與 participant = self 時為 null']
  is_non_ticketed boolean [note: '⊚ 場次，行程中標示「非售票」（FR-014）']

  Note: '''
  最佳行程；每人每部影片最多一場，依日期與開演排列（FR-008、FR-013、FR-306）。
  個人模式 = 001 的行程。兩人模式：兩人各自以自己的分層、層內名次、有空時段、每日上限、相容判定排程（只約束自己），再依「兩人排程目標」（spec「狀態與公式」）在兩人各自達到個人最佳的組合中取一起看最多者、再比 ★。
  「自己的行程」= participant 為 self 或 together 的列；「同伴的行程」= partner 或 together 的列。
  '''
}

Table unscheduled_must_films {
  owner person_side [note: '這部必看是誰的（FR-311）；個人模式 = self']
  film_id varchar
  reason unscheduled_reason
  conflict_film_ids "film_id[]" [null]

  indexes {
    (owner, film_id) [pk]
  }

  Note: '未排入的必看片與原因（FR-012）。兩人模式分別列出自己與同伴各自排不進去的必看片，並標明是誰的必看（FR-311）。'
}

Table ticket_list_items {
  film_id varchar [pk]
  order int
  current_session_id varchar [note: '目前要搶的場次：排定場次，或沒搶到後切換的下一個備案']
  backup_session_ids "session_id[]" [note: '備案：★ 優先、再依時間；排程時須與行程其他場次相容（FR-016），搶票中只需與 got 場次相容（FR-020）。一起看的片，備案須兩人都可看、都不超過各自上限；自己看的片，備案只看自己']
  exhausted boolean [note: '已無可用場次']
  ticket_quantity int [null, note: '兩人模式：一起看 = 2（顯示「買 2 張」）、自己看 = 1（顯示「買 1 張」）；個人模式 = null（不顯示張數）。FR-312、FR-401']

  Note: '''
  個人模式：搶票清單 = 自己的行程中的售票場次，順序規則見 001 spec「狀態與公式」，可手動調整。
  兩人模式（004 起）：搶票清單 = 兩人分工表中「分給本人」的列（我的順序），同伴的列為「{同伴}的順序」（見 ticket_division_items）；一起看的片只在負責人的清單；兩人模式不套用 manual_order。不含 ⊚ 場次（FR-017）。
  '''
}

Table ticket_division_items {
  film_id varchar
  participant itinerary_participant [note: '一起看 = together；只有一人看 = self 或 partner（相對本裝置）；同一部片兩人各看不同場時是兩筆']
  owner person_side [note: '負責人（FR-403）：自己看的給本人；一起看的給目前筆數較少者，同筆數給名字（Unicode 碼點順序）較前者；名字相同改比兩人設定指紋。結果與「誰是本裝置使用者」無關（FR-404）']
  global_order int [note: '整體順序（兩人共用）：層級（一起取較高）→ 熱門（一起取任一人）→ 可看場次少（一起以兩人都可看計）→ ★ → 影片順序（FR-402）']
  order int [note: '負責人清單內的名次（1 起）']
  ticket_quantity int [note: '一起 = 2、自己 = 1；每筆訂單一個場次、不需拆單（CL-404）']
  current_session_id varchar
  backup_session_ids "session_id[]" [note: '一起看的片，備案須兩人都可看、都不超過各自上限、與各自行程其他場次相容（沿用 FR-312）']
  exhausted boolean

  indexes {
    (film_id, owner) [pk]
  }

  Note: '''
  兩人分工表（004，衍生、不保存、不改 schema_version）：由兩人行程（itinerary_entries）與兩人設定即時算出，兩台裝置各自算出相同結果；手動順序與搶票標記不影響分工，標記只影響每列的目前場次與備案（標記屬本裝置，可標在任一人的列，FR-407、FR-409）。
  摘要 = 每人的筆數（列數）與張數（ticket_quantity 加總）（FR-406）。
  '''
}

Ref: itinerary_entries.session_id > sessions.session_id
Ref: ticket_list_items.film_id > films.film_id
Ref: ticket_division_items.film_id > films.film_id

// 005 衍生實體（不保存）：取捨（tradeoff）
// 欄位：owner（self／partner）、film_id、選項 A（一起看或目前場次、是否一起看）、選項 B（優先場、是否一起看）、目前選擇（a／b）、放棄的優先場、B 相對 A 的差異清單。
// 條件與公式見 specs/plans/005-ghff-session-preference/spec.md「狀態與公式」；由 src/domain/tradeoff.ts 以實際重跑兩人排程計算。
